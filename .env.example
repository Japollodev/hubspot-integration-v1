# Copy to .env and fill in. Never commit .env.

ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true

# Upload limit in megabytes (Step 1)
MAX_UPLOAD_MB=10

# Step 3 — OpenAI structured extraction
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Postgres. Local default matches docker-compose `db` (make db-up).
# Production (Neon / RDS / Cloud SQL): paste the provider URL; postgres:// and ?sslmode= work.
DATABASE_URL=postgresql+asyncpg://importer:importer@localhost:5432/importer
# Direct (non-pooled) URL for migrations, e.g. Neon's non "-pooler" host. Optional.
# DATABASE_URL_DIRECT=
# Force pooler mode on/off (auto-detects Neon "-pooler" hosts). Optional.
# DB_POOLED=true
# Run `alembic upgrade head` at container start (set false when migrating as a separate job)
# RUN_MIGRATIONS=true

# HubSpot TEST account private-app access token. Scopes: `files` (Step 1), CRM contacts (Step 4).
# Leave blank to skip the HubSpot upload (status "skipped").
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_FILES_FOLDER=/crm-importer/uploads

# Tests use a separate database (created automatically if missing)
# TEST_DATABASE_URL=postgresql+asyncpg://importer:importer@localhost:5432/importer_test

# Only needed if the frontend is served from a different origin (JSON list)
# CORS_ORIGINS=["http://localhost:5173"]
